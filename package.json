{
  "name": "torob-yar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/start.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:db": "tsx scripts/build-db.ts",
    "build:fixtures": "tsx scripts/build-fixtures.ts",
    "doctor": "tsx scripts/doctor.ts",
    "smoke": "tsx scripts/smoke.ts",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "demo": "sh scripts/demo.sh",
    "test": "vitest run && npm run search-eval",
    "search-eval": "tsx --conditions=react-server scripts/search-eval.ts",
    "trace": "tsx --conditions=react-server scripts/trace.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "ai": "^7.0.151",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
